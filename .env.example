# Copie para .env (no computador) ou cadastre como variáveis de ambiente na Hostinger.

# Endereço público do sistema (sem barra no final). Usado para registrar o webhook na Uazapi.
APP_URL=https://condominio.seudominio.com.br
PORT=3000
TZ=America/Sao_Paulo

# Chave longa e aleatória para assinar o login do painel
SESSION_SECRET=troque-por-uma-frase-longa-e-aleatoria

# Supabase: Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-nunca-exponha-no-navegador

# Uazapi: endereço do seu servidor e token da instância deste prédio
UAZAPI_URL=https://seu-subdominio.uazapi.com
UAZAPI_TOKEN=token-da-instancia
# Segredo que vai na URL do webhook, para recusar chamadas falsas
WEBHOOK_SECRET=outra-frase-aleatoria

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Transcrição dos áudios dos moradores
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Envio de avisos: intervalo entre mensagens (segundos) e horário permitido
ENVIO_INTERVALO_MIN=25
ENVIO_INTERVALO_MAX=60
ENVIO_HORA_INICIO=8
ENVIO_HORA_FIM=21
