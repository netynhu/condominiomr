<%- include('partials/topo') %>
<div class="cabeca">
  <div><h1>Moradores</h1><p class="muted"><%= total %> cadastrados. Só números cadastrados aqui são atendidos pelo assistente.<%= autocadastro ? ' Quem está no grupo também pode se cadastrar sozinho.' : '' %></p></div>
  <form method="get" action="/moradores" class="acoes"><input name="q" id="q" value="<%= busca %>" placeholder="Buscar nome, telefone, apto ou vaga" style="width:240px"><button class="btn sec" type="submit">Buscar</button></form>
</div>

<% if (paraConferir.length) { %>
<div class="card" style="margin-bottom:20px">
  <div class="acoes" style="justify-content:space-between;align-items:center">
    <div><h2>Cadastros pelo grupo para conferir <span class="tag alta"><%= paraConferir.length %></span></h2>
      <p class="small muted">Estas pessoas estão no grupo e se cadastraram sozinhas. Confira se o apartamento está certo. Enquanto não forem conferidas, elas abrem chamados e tiram dúvidas, mas não registram reclamação.</p></div>
    <% if (paraConferir.length > 1) { %><form method="post" action="/moradores/conferir-todos" data-confirmar="Marcar os <%= paraConferir.length %> cadastros como conferidos?"><button class="btn sec" type="submit">Conferir todos</button></form><% } %>
  </div>
  <div class="tabela" style="box-shadow:none">
    <table>
      <thead><tr><th>Unidade</th><th>Nome</th><th>Vínculo</th><th>Vaga</th><th>Cadastrou em</th><th></th></tr></thead>
      <tbody>
        <% for (const m of paraConferir) { %>
          <tr>
            <td class="num"><%= m.unidade ? (m.unidade.bloco ? m.unidade.bloco + ' · ' : '') + m.unidade.numero : '-' %><% if (m.naUnidade > 4) { %> <span class="tag nova" title="Muitos cadastros no mesmo apartamento"><%= m.naUnidade %> no apto</span><% } %></td>
            <td><a href="/moradores/<%= m.id %>"><%= m.nome %></a><div class="small muted"><%= u.formatarTelefone(m.telefone) %></div></td>
            <td><%= { proprietario: 'Proprietário', inquilino: 'Inquilino', morador: 'Mora com o titular', outro: 'Outro' }[m.tipo] || m.tipo %></td>
            <td class="num"><%= m.vaga || '-' %></td>
            <td class="small muted"><%= u.dataHora(m.criado_em) %></td>
            <td><div class="acoes equipe-acoes">
              <form method="post" action="/moradores/<%= m.id %>/conferir"><button class="btn peq" type="submit">Conferido</button></form>
              <a class="btn sec peq" href="/moradores/<%= m.id %>">Corrigir</a>
            </div></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<div class="grade2">
  <div class="tabela">
    <table>
      <thead><tr><th>Unidade</th><th>Nome</th><th>Telefone</th><th>Vaga</th><th>Avisos</th><th>Última conversa</th></tr></thead>
      <tbody>
        <% if (!lista.length) { %><tr><td colspan="6" class="muted">Nenhum morador ainda. Cadastre ao lado ou importe uma lista.</td></tr><% } %>
        <% for (const m of lista) { %>
          <tr style="<%= m.ativo ? '' : 'opacity:.5' %>">
            <td class="num"><%= m.unidade ? (m.unidade.bloco ? m.unidade.bloco + ' · ' : '') + m.unidade.numero : '-' %></td>
            <td><a href="/moradores/<%= m.id %>"><%= m.nome %></a> <span class="small muted"><%= m.tipo %></span><% if (m.autocadastro && m.conferido === false) { %> <span class="tag alta">a conferir</span><% } %><% if (m.bloqueado_ate && new Date(m.bloqueado_ate) > new Date()) { %> <span class="tag nova" title="Atendimento pausado por assuntos fora do condomínio">pausado</span><% } %></td>
            <td class="num"><%= u.formatarTelefone(m.telefone) %></td>
            <td class="num"><%= m.vaga || '-' %></td>
            <td><%= m.aceita_avisos ? 'Sim' : 'Não' %></td>
            <td class="small muted"><%= m.ultima_interacao ? u.dataHora(m.ultima_interacao) : 'nunca' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div style="display:flex;flex-direction:column;gap:16px">
    <% if (autocadastro) { %>
    <details class="card"<%= total ? '' : ' open' %>>
      <summary>Convidar moradores pelo grupo</summary>
      <% if (!temGrupo) { %>
        <p class="small muted">Primeiro escolha o grupo dos moradores em <a href="/whatsapp/grupos">WhatsApp &gt; Grupos</a> e peça ao síndico para adicionar o número do assistente no grupo.</p>
      <% } else { %>
        <p class="small muted">O assistente posta esta mensagem no grupo <b><%= grupoNome || 'dos moradores' %></b>. Quem tocar no link e enviar a mensagem pronta é cadastrado, se o número estiver no grupo.</p>
        <div class="ia small"><%= convite %></div>
        <form method="post" action="/moradores/convite-grupo" data-confirmar="Postar o convite de cadastro no grupo <%= grupoNome || 'dos moradores' %>?">
          <button class="btn" type="submit"<%= linkCadastro ? '' : ' disabled' %>>Postar convite no grupo</button>
        </form>
        <% if (!linkCadastro) { %><p class="small muted">O WhatsApp do assistente não está conectado agora.</p><% } %>
      <% } %>
    </details>
    <% } %>
    <form class="card campos" method="post" action="/moradores" id="novo">
      <h2>Cadastrar morador</h2>
      <label>Nome<input name="nome" id="novo-nome" value="<%= novo.nome %>" required></label>
      <label>WhatsApp com DDD<input name="telefone" id="novo-telefone" value="<%= novo.telefone ? u.formatarTelefone(novo.telefone) : '' %>" inputmode="tel" required placeholder="(11) 99999-8888"></label>
      <div class="linha-campos">
        <label>Bloco<input name="bloco" id="novo-bloco" placeholder="A"></label>
        <label>Apartamento<input name="numero" id="novo-numero" required placeholder="304"></label>
        <label>Vaga<input name="vaga" id="novo-vaga" placeholder="12"></label>
      </div>
      <div class="linha-campos">
        <label>Vínculo<select name="tipo" id="novo-tipo"><option value="morador">Morador</option><option value="proprietario">Proprietário</option><option value="inquilino">Inquilino</option><option value="outro">Outro</option></select></label>
        <label>E-mail<input type="email" name="email" id="novo-email"></label>
      </div>
      <label class="check"><input type="checkbox" name="boas_vindas" id="novo-boas-vindas" checked> Enviar boas-vindas no WhatsApp<%= cfg.grupo_convite ? ' com o botão para entrar no grupo' : '' %></label>
      <button class="btn" type="submit">Cadastrar</button>
      <% if (!cfg.grupo_convite) { %><p class="small muted">Para a mensagem ter o botão "Entrar no grupo", cole o link de convite do grupo em <a href="/configuracoes">Ajustes do prédio</a>.</p><% } %>
    </form>

    <details class="card">
      <summary>Importar lista de moradores</summary>
      <form class="campos" method="post" action="/moradores/importar">
        <p class="small muted">Uma linha por morador, separando com ponto e vírgula: <code>nome; telefone; bloco; apartamento; e-mail; vaga</code>. Pode colar direto de uma planilha. E-mail e vaga são opcionais. Telefones já cadastrados são atualizados.</p>
        <textarea name="lista" id="lista" placeholder="Carla Mendes; 11999998888; B; 304; carla@email.com; 12"></textarea>
        <label class="check"><input type="checkbox" name="boas_vindas" id="importar-boas-vindas"> Enviar boas-vindas para todos os importados (saem aos poucos, pela fila)</label>
        <button class="btn sec" type="submit">Importar</button>
      </form>
    </details>
  </div>
</div>
<%- include('partials/rodape') %>
