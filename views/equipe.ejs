<%- include('partials/topo') %>
<% const perfis = { sindico: 'Síndico', admin: 'Administração', zelador: 'Manutenção', portaria: 'Portaria', conselho: 'Conselho' };
   const DIAS = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];
   const textoTurno = (t) => t && t.dias && t.dias.length ? `${t.dias.map((d) => DIAS[d]).join(', ')} · ${t.inicio} às ${t.fim}` : 'sem horário (recebe sempre)';
   // Campos do horário de trabalho da manutenção
   const camposTurno = (t, idBase) => `<fieldset class="turno" data-turno="${idBase}"><legend class="small" style="font-weight:600">Horário de trabalho neste condomínio</legend>
     <div class="dias">${DIAS.map((n, i) => `<label class="check"><input type="checkbox" name="dias" value="${i}" ${t && t.dias && t.dias.includes(i) ? 'checked' : ''}> ${n}</label>`).join('')}</div>
     <div class="linha-campos"><label>Das<input type="time" name="turno_inicio" value="${(t && t.inicio) || '08:00'}"></label><label>Às<input type="time" name="turno_fim" value="${(t && t.fim) || '17:00'}"></label></div>
     <p class="small muted" style="margin:0">Sem nenhum dia marcado, a pessoa recebe os chamados a qualquer hora. Vale quando o síndico escolhe, em Ajustes, mandar os chamados só para quem está no horário.</p></fieldset>`; %>
<div class="cabeca">
  <div><h1>Equipe e acessos</h1><p class="muted">Quem entra no sistema. Cada perfil vê só a sua parte. A equipe de manutenção entra pelo link enviado no WhatsApp, sem senha. Os outros perfis entram com e-mail e senha.</p></div>
</div>

<div class="grade-equipe">
  <div class="tabela">
    <table>
      <thead><tr><th>Nome</th><th>Perfil</th><th>Situação</th><th></th></tr></thead>
      <tbody>
        <% for (const x of usuarios) { const semEmail = x.email.endsWith('@sem-email.local'); %>
          <tr>
            <td><b><%= x.nome %></b><div class="small muted"><%= semEmail ? 'entra pelo link' : x.email %><%= x.telefone ? ' · ' + u.formatarTelefone(x.telefone) : '' %></div></td>
            <td><%= perfis[x.perfil] %><% if (x.perfil === 'zelador') { %><div class="small muted"><%= textoTurno(x.turno) %></div><% } %></td>
            <td><span class="tag <%= x.ativo ? 'resolvido' : '' %>"><%= x.ativo ? 'Ativo' : 'Bloqueado' %></span></td>
            <td>
              <div class="acoes equipe-acoes">
                <% if (x.ativo && x.perfil === 'zelador') { %>
                <form method="post" action="/equipe/<%= x.id %>/link" data-confirmar="Gerar um novo link de acesso para <%= x.nome %>? O link anterior deixa de funcionar.">
                  <button class="btn sec peq" type="submit">Enviar link</button>
                </form>
                <% } %>
                <button class="btn sec peq" type="button" data-abrir="editar-<%= x.id %>">Editar</button>
              </div>
              <dialog class="janela" id="editar-<%= x.id %>">
                <form class="campos" method="post" action="/equipe">
                  <div class="janela-topo"><h2>Editar acesso</h2><button class="icone-btn" type="button" data-fechar aria-label="Fechar">✕</button></div>
                  <input type="hidden" name="id" value="<%= x.id %>">
                  <label>Nome<input name="nome" value="<%= x.nome %>" required></label>
                  <div class="linha-campos">
                    <label>Perfil<select name="perfil"><% for (const [k, n] of Object.entries(perfis)) { %><option value="<%= k %>" <%= x.perfil === k ? 'selected' : '' %>><%= n %></option><% } %></select></label>
                    <label>WhatsApp<input name="telefone" value="<%= x.telefone ? u.formatarTelefone(x.telefone) : '' %>" inputmode="tel" placeholder="(11) 99999-8888"></label>
                  </div>
                  <% if (semEmail) { %>
                    <input type="hidden" name="email" value="<%= x.email %>">
                    <p class="small muted">Entra pelo link enviado no WhatsApp, sem e-mail e senha.</p>
                  <% } else { %>
                    <div class="linha-campos">
                      <label>E-mail<input type="email" name="email" value="<%= x.email %>" required></label>
                      <label>Nova senha<input type="password" name="senha" minlength="8" placeholder="Deixe vazio para manter" autocomplete="new-password"></label>
                    </div>
                  <% } %>
                  <% if (x.perfil === 'zelador') { %><%- camposTurno(x.turno, x.id) %><% } %>
                  <label class="check"><input type="checkbox" name="ativo" <%= x.ativo ? 'checked' : '' %>> Acesso ativo</label>
                  <div class="janela-acoes">
                    <% if (x.id !== usuario.id) { %><button class="btn perigo" type="submit" form="excluir-<%= x.id %>">Excluir acesso</button><% } %>
                    <span style="flex:1"></span>
                    <button class="btn sec" type="button" data-fechar>Cancelar</button>
                    <button class="btn" type="submit">Salvar</button>
                  </div>
                </form>
                <form id="excluir-<%= x.id %>" method="post" action="/equipe/<%= x.id %>/excluir" data-confirmar="Excluir o acesso de <%= x.nome %>? A pessoa deixa de entrar no sistema e de receber os chamados no WhatsApp. Isso não pode ser desfeito."></form>
              </dialog>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <form class="card campos" method="post" action="/equipe" id="form-novo">
    <h2>Novo acesso</h2>
    <label>Perfil<select name="perfil" id="perfil"><% for (const [k, n] of Object.entries(perfis)) { %><option value="<%= k %>" <%= k === 'zelador' ? 'selected' : '' %>><%= n %></option><% } %></select></label>
    <label>Nome<input name="nome" id="nome" required></label>
    <label>WhatsApp<input name="telefone" id="telefone" inputmode="tel" placeholder="(11) 99999-8888"></label>
    <div id="turno-novo"><%- camposTurno(null, 'novo') %></div>
    <div id="campos-senha" class="campos" style="display:flex;flex-direction:column;gap:14px">
      <label>E-mail<input type="email" name="email" id="email"></label>
      <label>Senha inicial (mínimo 8)<input type="password" name="senha" id="senha" minlength="8" autocomplete="new-password"></label>
    </div>
    <button class="btn" type="submit">Criar acesso</button>
    <p class="small muted" id="dica"></p>
  </form>
</div>
<script>
document.addEventListener('click', (e) => {
  const abrir = e.target.closest('[data-abrir]');
  if (abrir) document.getElementById(abrir.dataset.abrir).showModal();
  const fechar = e.target.closest('[data-fechar]');
  if (fechar) fechar.closest('dialog').close();
  if (e.target.tagName === 'DIALOG') e.target.close();
});
(function () {
  const perfil = document.getElementById('perfil');
  const dicas = {
    zelador: 'A manutenção não precisa de e-mail nem senha. Depois de criar, clique em "Enviar link de acesso": a pessoa recebe o link no WhatsApp e fica conectada no celular. Ela também recebe os chamados novos nesse número.',
    sindico: 'Acesso completo ao painel. Com o WhatsApp cadastrado, ele recebe os alertas do síndico e pode pedir ao assistente pelo WhatsApp: avisos no grupo, eventos, chamados e resumo do prédio. O aviso só sai depois que ele confirma.',
    admin: 'Acesso completo ao painel. Com o WhatsApp cadastrado, também pode usar o assistente pelo WhatsApp, como o síndico.',
    portaria: 'Registra as encomendas pelo celular (foto e apartamento) e vê as reclamações, sem saber quem reclamou. Entra com e-mail e senha. No celular, depois de entrar, use "Adicionar à tela inicial" para virar um app.',
    conselho: 'Vê o relatório e o radar do grupo, só leitura.',
  };
  function atualizar() {
    const z = perfil.value === 'zelador';
    document.getElementById('campos-senha').style.display = z ? 'none' : 'flex';
    document.getElementById('email').required = !z;
    document.getElementById('senha').required = !z;
    document.getElementById('telefone').required = z;
    document.getElementById('turno-novo').hidden = !z;
    document.getElementById('dica').textContent = dicas[perfil.value];
  }
  perfil.addEventListener('change', atualizar);
  atualizar();
})();
</script>
<%- include('partials/rodape') %>
