<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0C1B1F">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Portaria">
<title>Encomendas · Portaria</title>
<link rel="icon" href="/static/icone.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/static/icone-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="/static/estilo.css?v=6">
<script src="/static/dialogo.js?v=3" defer></script>
<script src="/static/app.js?v=3" defer></script>
<style>
  body{background:var(--bg)}
  .pt-topo{position:sticky;top:0;z-index:5;background:var(--side);color:#fff;display:flex;align-items:center;gap:12px;padding:12px 16px;padding-top:calc(12px + env(safe-area-inset-top,0px))}
  .pt-topo b{display:block;font-size:1rem}
  .pt-topo small{color:var(--side-muted);font-size:.78rem}
  .pt-topo>div{flex:1;min-width:0}
  .pt-topo .icone-btn{color:#fff}
  .pt{max-width:560px;margin:0 auto;padding:14px 14px calc(90px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;gap:14px}
  .pt-foto{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;min-height:150px;border:2px dashed var(--line-2);border-radius:16px;background:var(--surface);cursor:pointer;font-weight:700;color:var(--ink-2);text-align:center;padding:12px}
  .pt-foto img{max-height:220px;max-width:100%;border-radius:12px}
  .pt-foto .grande{font-size:2.2rem;line-height:1}
  .pt input.apto{font-size:1.6rem;font-weight:800;text-align:center;letter-spacing:.06em;min-height:60px}
  .pt .btn.grande{min-height:56px;font-size:1.05rem}
  .pt-item{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px;display:flex;gap:12px;align-items:center}
  .pt-item img{width:56px;height:56px;object-fit:cover;border-radius:10px;flex:none}
  .pt-item>div{flex:1;min-width:0}
  .pt-item .btn{min-height:48px}
  .pt-abas{position:fixed;left:0;right:0;bottom:0;z-index:5;display:grid;grid-template-columns:1fr 1fr;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
  .pt-abas a{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px;color:var(--muted);font-size:.78rem;font-weight:600;text-decoration:none}
  .pt-abas a.ativo{color:var(--accent)}
  .pt-abas svg{width:22px;height:22px}
</style>
</head>
<body>
<header class="pt-topo">
  <span class="logo"><%- icone('encomendas') %></span>
  <div><b>Encomendas</b><small><%= cfg.nome_predio %></small></div>
  <form method="post" action="/sair"><button class="icone-btn" type="submit" aria-label="Sair"><%- icone('sair') %></button></form>
</header>

<main class="pt">
  <% if (aviso) { %><div class="flash <%= aviso.tipo === 'erro' ? 'erro' : '' %>" role="status"><%= aviso.texto %></div><% } %>
  <% if (semTabela) { %><div class="alerta">Falta rodar a migração 011 no banco.</div><% } %>

  <form class="campos" method="post" action="/encomendas" id="form-encomenda">
    <label class="pt-foto" for="arquivo-foto">
      <input type="file" id="arquivo-foto" accept="image/*" capture="environment" hidden>
      <img id="previa-foto" alt="Foto do pacote" hidden>
      <span class="grande" id="icone-foto">📷</span>
      <span id="texto-foto">Tirar foto do pacote</span>
    </label>
    <input type="hidden" name="imagem" id="imagem">
    <label>Apartamento<input class="apto" name="apto" id="apto" required autocomplete="off" inputmode="<%= usaBlocos ? 'text' : 'numeric' %>" placeholder="<%= usaBlocos ? 'A 304' : '304' %>"></label>
    <details><summary class="small" style="cursor:pointer">Observação (opcional)</summary>
      <input name="observacao" maxlength="200" autocomplete="off" placeholder="Ex.: Mercado Livre, caixa grande" style="margin-top:8px;width:100%">
    </details>
    <button class="btn grande" type="submit">Avisar o morador</button>
  </form>

  <h2 style="margin-top:6px">Na portaria <% if (aguardando.length) { %><span class="tag alta"><%= aguardando.length %></span><% } %></h2>
  <% if (!aguardando.length) { %><p class="muted">Nenhuma encomenda esperando retirada.</p><% } %>
  <% for (const e of aguardando) { const d = Math.floor((Date.now() - new Date(e.recebida_em).getTime()) / 86400000); %>
    <div class="pt-item">
      <% if (e.foto) { %><img src="/encomendas/<%= e.id %>/foto" alt="Foto da encomenda"><% } %>
      <div><b><%= e.unidade ? u.rotuloUnidade(e.unidade) : 'Unidade ?' %></b>
        <div class="small muted"><%= d === 0 ? 'hoje' : 'há ' + d + ' dia' + (d > 1 ? 's' : '') %><%= e.observacao ? ' · ' + e.observacao : '' %></div></div>
      <form method="post" action="/encomendas/<%= e.id %>/entregue" data-confirmar="Entregue para o <%= e.unidade ? u.rotuloUnidade(e.unidade) : 'morador' %>?"><button class="btn" type="submit">Entregue</button></form>
    </div>
  <% } %>
</main>

<nav class="pt-abas">
  <a href="/encomendas" class="ativo"><%- icone('encomendas') %>Encomendas</a>
  <a href="/reclamacoes"><%- icone('reclamacoes') %>Reclamações<%= contadores.reclamacoes ? ' (' + contadores.reclamacoes + ')' : '' %></a>
</nav>
<script src="/static/foto.js?v=2"></script>
<script>
ligarFoto('arquivo-foto', 'previa-foto', 'texto-foto', (dados) => {
  document.getElementById('imagem').value = dados;
  document.getElementById('icone-foto').hidden = true;
  document.getElementById('texto-foto').textContent = 'Trocar foto';
  document.getElementById('apto').focus();
});
</script>
</body>
</html>
