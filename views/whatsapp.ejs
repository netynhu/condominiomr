<%- include('partials/topo') %>
<div class="cabeca">
  <div><h1>Conexão do WhatsApp</h1><p class="muted">O número do prédio que conversa com os moradores.</p></div>
</div>

<div class="grade2">
  <div class="card" id="painel-conexao">
    <div class="acoes" style="justify-content:space-between">
      <h2>Status</h2>
      <span class="tag <%= status ? status.estado : 'erro' %>" id="tag-status"><%= status ? ({connected:'Conectado',connecting:'Aguardando leitura',disconnected:'Desconectado',hibernated:'Em pausa'}[status.estado] || status.estado) : 'Sem resposta' %></span>
    </div>

    <% if (erro) { %>
      <div class="flash erro">Não foi possível falar com a Uazapi: <%= erro %>. Confira UAZAPI_URL e UAZAPI_TOKEN no servidor.</div>
    <% } %>

    <div id="conectado" <%= status && status.conectado ? '' : 'hidden' %>>
      <p>O assistente está atendendo pelo número <b id="numero"><%= status && status.numero ? u.formatarTelefone(status.numero) : '' %></b><%= status && status.perfil ? ` (${status.perfil})` : '' %>.</p>
      <div class="acoes" style="margin-top:12px">
        <form method="post" action="/whatsapp/desconectar" data-confirmar="Desconectar o WhatsApp do prédio? O assistente para de responder até ler um novo QR code."><button class="btn perigo" type="submit">Desconectar</button></form>
      </div>
    </div>

    <div id="desconectado" <%= status && status.conectado ? 'hidden' : '' %>>
      <div class="qr" id="qr" hidden>
        <img id="qr-img" alt="QR code para conectar o WhatsApp">
        <div class="paircode" id="paircode" hidden></div>
        <p class="muted small" id="qr-texto">No celular do prédio: WhatsApp &gt; Configurações &gt; Dispositivos conectados &gt; Conectar dispositivo. Aponte a câmera para o código.</p>
      </div>
      <form class="campos" id="form-conectar">
        <p>Conecte o número exclusivo do prédio. Use um chip só para isso, nunca o número pessoal de alguém.</p>
        <label>Celular do prédio (opcional, só para conectar por código em vez de QR)
          <input name="telefone" id="telefone" inputmode="tel" placeholder="(11) 99999-8888">
        </label>
        <div class="acoes"><button class="btn" type="submit" id="btn-conectar">Gerar QR code</button></div>
      </form>
    </div>
  </div>

  <div class="card">
    <h2>Grupo dos moradores</h2>
    <p class="muted">O assistente lê o grupo para entender os assuntos do prédio e conhecer os moradores. Ele nunca escreve no grupo.</p>
    <p>Grupo lido: <b><%= cfg.grupo_nome || 'nenhum' %></b></p>
    <div class="acoes"><a class="btn sec" href="/whatsapp/grupos">Escolher grupo</a></div>
    <p class="small muted">Recomendação: avise no grupo que o assistente do prédio lê as mensagens.</p>
    <hr style="border:0;border-top:1px solid var(--line);width:100%">
    <h2>Recebimento de mensagens</h2>
    <p class="small muted">Endereço que a Uazapi usa para entregar as mensagens: <code><%= webhook || 'defina APP_URL' %></code>. Ele é configurado sozinho ao gerar o QR code.</p>
    <form method="post" action="/whatsapp/webhook"><button class="btn sec peq" type="submit">Configurar de novo</button></form>
  </div>
</div>

<script>
(function () {
  const rotulos = { connected: 'Conectado', connecting: 'Aguardando leitura', disconnected: 'Desconectado', hibernated: 'Em pausa' };
  const $ = (id) => document.getElementById(id);
  let timer = null;

  function mostrar(s) {
    $('tag-status').textContent = rotulos[s.estado] || s.estado;
    $('tag-status').className = 'tag ' + s.estado;
    if (s.conectado) {
      clearInterval(timer);
      $('conectado').hidden = false; $('desconectado').hidden = true;
      if (s.numero) $('numero').textContent = s.numero;
      setTimeout(() => location.reload(), 800);
      return;
    }
    if (s.qrcode) { $('qr').hidden = false; $('qr-img').hidden = false; $('qr-img').src = s.qrcode; }
    if (s.paircode) {
      $('qr').hidden = false; $('qr-img').hidden = !s.qrcode; $('paircode').hidden = false; $('paircode').textContent = s.paircode;
      $('qr-texto').textContent = 'No celular do prédio: WhatsApp > Dispositivos conectados > Conectar dispositivo > Conectar com número de telefone. Digite o código acima.';
    }
  }

  function acompanhar() {
    clearInterval(timer);
    let voltas = 0;
    timer = setInterval(async () => {
      if (++voltas > 60) { clearInterval(timer); $('qr').hidden = true; dialogo.aviso('O QR code expirou', { texto: 'Clique em Gerar QR code para criar outro.' }); return; }
      try { const r = await fetch('/whatsapp/status.json'); if (r.ok) mostrar(await r.json()); } catch (e) {}
    }, 3000);
  }

  $('form-conectar').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = $('btn-conectar');
    await ocupado(btn, async () => {
      const s = await postJSON('/whatsapp/conectar', { telefone: $('telefone').value });
      mostrar(s);
      if (!s.qrcode && !s.paircode && !s.conectado) $('qr-texto').textContent = 'Gerando o código...';
      $('qr').hidden = false;
      acompanhar();
    });
    btn.textContent = 'Gerar novo código';
  });

  <% if (status && status.estado === 'connecting') { %> acompanhar(); <% } %>
})();
</script>
<%- include('partials/rodape') %>
