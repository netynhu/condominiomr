<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= titulo %> · <%= cfg.nome_predio %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
<link rel="icon" href="/static/icone.svg?v=2" type="image/svg+xml">
<link rel="icon" href="/static/icone-192.png?v=2" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="/static/icone-192.png?v=2">
<link rel="stylesheet" href="/static/estilo.css?v=7">
<script src="/static/dialogo.js?v=3" defer></script>
<script src="/static/app.js?v=3" defer></script>
</head>
<body class="<%= usuario ? 'com-menu' : 'sem-menu' %>">
<% if (usuario) {
  // Menu em duas partes:
  // 1) Geral (síndico e super admin): o que é de todos os condomínios dele, inclusive o número de WhatsApp
  // 2) Condomínio da vez: dia a dia (Operação), gestão do prédio (Administração) e ajustes (Configuração)
  const gestor = usuario.dono || usuario.cargo === 'sindico';
  const geral = usuario.perfil !== 'admin' ? [] : gestor
    ? [['Geral', [['/visao-geral', 'radar', 'Visão geral'], ['/condominios', 'predio', 'Condomínios'], ['/whatsapp', 'whatsapp', 'WhatsApp']]]]
    : (condominios.length > 1 ? [['Geral', [['/visao-geral', 'radar', 'Visão geral']]]] : []);
  const grupos = {
    admin: [
      ['Operação', [['/', 'inicio', 'Início'], ['/assistente', 'ia', 'Assistente'],['/chamados', 'chamados', 'Chamados', contadores.chamados], ['/reclamacoes', 'reclamacoes', 'Reclamações', contadores.reclamacoes], ['/duvidas', 'duvidas', 'Dúvidas', contadores.duvidas], ['/encomendas', 'encomendas', 'Encomendas', contadores.encomendas], ['/avisos', 'avisos', 'Avisos'], ['/reservas', 'reservas', 'Reservas'], ['/agenda', 'agenda', 'Agenda']]],
      ['Administração', [['/moradores', 'moradores', 'Moradores'], ['/espacos', 'check', 'Espaços e checklists'], ['/manutencoes', 'manutencao', 'Manutenção'], ['/radar', 'radar', 'Radar do grupo'], ['/relatorio', 'relatorio', 'Relatório']]],
      ['Configuração', [['/implantacao', 'check', 'Implantação'], ['/documentos', 'documentos', 'Documentos'], ['/whatsapp/grupos', 'moradores', 'Grupos'], ['/equipe', 'equipe', 'Equipe e acessos'], ['/configuracoes', 'configuracoes', 'Ajustes do prédio']]],
    ],
    zelador: [['Operação', [['/z', 'chamados', 'Meus chamados', contadores.chamados]]]],
    portaria: [['Operação', [['/encomendas', 'encomendas', 'Encomendas', contadores.encomendas], ['/reclamacoes', 'reclamacoes', 'Reclamações', contadores.reclamacoes]]]],
    conselho: [['Acompanhamento', [['/relatorio', 'relatorio', 'Relatório'], ['/radar', 'radar', 'Radar do grupo']]]],
  }[usuario.perfil] || [];
  const ativo = (href) => href === '/' ? caminho === '/' : href === '/whatsapp' ? caminho === '/whatsapp' : (caminho === href || caminho.startsWith(href + '/'));
  let secaoAtual = '';
  for (const [g, itens] of [...geral, ...grupos]) for (const it of itens) if (ativo(it[0])) secaoAtual = g;
  const perfis = { sindico: 'Síndico', admin: 'Administração', zelador: 'Manutenção', portaria: 'Portaria', conselho: 'Conselho' };
  const iniciais = usuario.nome.split(/\s+/).filter(Boolean).slice(0, 2).map(p => p[0]).join('').toUpperCase();
%>
<div class="app">
  <aside class="lateral" id="lateral">
    <div class="lateral-marca">
      <span class="logo"><%- icone('predio') %></span>
      <div><b>Assistente</b><small><%= usuario.dono ? 'Super admin' : (condominios.length > 1 ? condominios.length + ' condomínios' : 'do condomínio') %></small></div>
      <button class="so-celular icone-btn" type="button" data-fechar-menu aria-label="Fechar menu"><%- icone('fechar') %></button>
    </div>
    <nav class="lateral-nav">
      <% for (const [grupo, itens] of geral) { %>
        <div class="grupo">
          <span class="grupo-titulo"><%= grupo %></span>
          <% for (const [href, ic, nome, num] of itens) { %>
            <a href="<%= href %>" class="<%= ativo(href) ? 'ativo' : '' %>" <%= ativo(href) ? 'aria-current=page' : '' %>><%- icone(ic) %><span><%= nome %></span></a>
          <% } %>
        </div>
      <% } %>
      <% if (usuario.perfil === 'admin' && (condominioAtual || gestor)) { %>
        <div class="bloco-condominio">
          <span class="grupo-titulo">Condomínio</span>
          <% if (condominios.length > 1) { %>
            <form class="seletor-condominio" method="post" action="/condominio/trocar">
              <input type="hidden" name="voltar" value="<%= caminho %>">
              <label for="trocar-condominio" class="sr-only">Condomínio</label>
              <select name="id" id="trocar-condominio" onchange="this.form.submit()">
                <% for (const c of condominios) { %><option value="<%= c.id %>" <%= condominioAtual && c.id === condominioAtual.id ? 'selected' : '' %>><%= c.nome %></option><% } %>
              </select>
              <noscript><button class="btn sec peq" type="submit">Trocar</button></noscript>
            </form>
          <% } else if (condominioAtual) { %>
            <div class="nome-condominio"><%- icone('predio') %><span><%= condominioAtual.nome %></span></div>
          <% } else { %>
            <div class="nome-condominio"><span>Nenhum ainda. Crie em Condomínios.</span></div>
          <% } %>
        </div>
      <% } %>
      <% for (const [grupo, itens] of (condominioAtual || usuario.perfil !== 'admin' ? grupos : [])) { %>
        <div class="grupo">
          <span class="grupo-titulo"><%= grupo %></span>
          <% for (const [href, ic, nome, num] of itens) { %>
            <a href="<%= href %>" class="<%= ativo(href) ? 'ativo' : '' %>" <%= ativo(href) ? 'aria-current=page' : '' %>>
              <%- icone(ic) %><span><%= nome %></span>
              <% if (num) { %><em class="contador"><%= num > 99 ? '99+' : num %></em><% } %>
            </a>
          <% } %>
        </div>
      <% } %>
    </nav>
    <div class="lateral-usuario">
      <span class="avatar"><%= iniciais %></span>
      <div><b><%= usuario.nome %></b><small><%= usuario.dono ? 'Super admin' : perfis[usuario.cargo || usuario.perfil] %></small></div>
      <form method="post" action="/sair"><button class="icone-btn" type="submit" title="Sair" aria-label="Sair"><%- icone('sair') %></button></form>
    </div>
  </aside>
  <div class="veu" data-fechar-menu></div>

  <div class="conteudo">
    <header class="barra">
      <button class="so-celular icone-btn" type="button" id="abrir-menu" aria-label="Abrir menu"><%- icone('menu') %></button>
      <div class="trilha"><% if (secaoAtual) { %><span><%= secaoAtual %></span><i>/</i><% } %><b><%= titulo %></b></div>
      <span class="barra-data"><%= u.dataExtenso(new Date().toISOString()).split(' às')[0] %></span>
    </header>
    <main>
<% } else { %>
    <main class="publico">
<% } %>
<% if (usuario && usuario.perfil === 'admin' && faltando.length) { %>
  <div class="alerta">Configuração incompleta no servidor. Faltam as variáveis <code><%= faltando.join(', ') %></code>. O assistente e as rotinas automáticas só funcionam depois disso.</div>
<% } %>
<% if (usuario && usuario.perfil === 'admin' && contadores.duvidas && !caminho.startsWith('/duvidas')) { %>
  <div class="alerta" style="justify-content:space-between;align-items:center;flex-wrap:wrap"><span><b><%= contadores.duvidas %> <%= contadores.duvidas === 1 ? 'pergunta de morador espera' : 'perguntas de moradores esperam' %> resposta.</b> O assistente não soube responder e prometeu retorno. Responda para o morador receber e o assistente aprender.</span><a class="btn peq" href="/duvidas">Responder agora</a></div>
<% } %>
<% if (aviso) { %><div class="flash <%= aviso.tipo === 'erro' ? 'erro' : '' %>" role="status"><%= aviso.texto %></div><% } %>
