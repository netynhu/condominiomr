<%- include('partials/topo') %>
<div class="cabeca"><div><h1>Grupo dos moradores<%= condominioAtual ? ' · ' + condominioAtual.nome : '' %></h1>
<p class="muted">Escolha qual dos grupos do WhatsApp é o dos moradores <b>deste condomínio</b>. O assistente lê o grupo, posta os avisos oficiais e usa o grupo para o cadastro dos moradores. Ele nunca conversa no grupo.</p></div>
</div>
<% if (erro) { %><div class="flash erro">Não foi possível listar os grupos: <%= erro %>. O WhatsApp está conectado?</div><% } %>
<div class="card">
  <p class="small muted">A lista mostra todos os grupos em que o número do assistente está (de todos os condomínios). Cada condomínio escolhe o seu, e um grupo só pode pertencer a um condomínio.</p>
  <% if (!grupos.length && !erro) { %><p class="muted">Nenhum grupo encontrado. Adicione o número do assistente ao grupo dos moradores e volte aqui.</p><% } %>
  <div class="lista">
    <% for (const g of grupos) { %>
      <div class="item">
        <div><b><%= g.nome %></b><% if (g.deOutro) { %><div class="small muted">já é o grupo do <%= g.deOutro %></div><% } %></div>
        <% if (g.jid === atual) { %>
          <span class="tag resolvido">Grupo deste condomínio</span>
        <% } else if (!g.deOutro) { %>
          <form method="post" action="/whatsapp/grupos"><input type="hidden" name="jid" value="<%= g.jid %>"><input type="hidden" name="nome" value="<%= g.nome %>"><button class="btn sec peq" type="submit">Usar neste condomínio</button></form>
        <% } %>
      </div>
    <% } %>
  </div>
  <% if (atual) { %>
    <form method="post" action="/whatsapp/grupos" data-confirmar="Parar de usar o grupo dos moradores neste condomínio?"><input type="hidden" name="jid" value=""><button class="btn perigo peq" type="submit">Desligar o grupo</button></form>
  <% } %>
</div>
<%- include('partials/rodape') %>
